{
  "$schema": "https://raw.githubusercontent.com/LingCore/WinShun-plugins/main/schema/plugin.schema.json",
  "manifest": 1,
  "id": "me.open-url",
  "name": {
    "zh": "打开网址",
    "en": "Open URL"
  },
  "version": "1.0.1",
  "description": {
    "zh": "输入一个网址，回车在默认浏览器中打开。",
    "en": "Type a web address and press Enter to open it in the default browser."
  },
  "license": "MIT",
  "author": "888bik",
  "homepage": "https://github.com/888bik/winshun-open-url",
  "runtime": {
    "mode": "once",
    "program": "python",
    "script": "main.py",
    "debounceMs": 40
  },
  "commands": [
    {
      "id": "open-url",
      "title": {
        "zh": "打开网址",
        "en": "Open URL"
      },
      "hint": {
        "zh": "网址",
        "en": "address"
      },
      "keyword": "url",
      "triggers": [
        {
          "regex": "^\\s*(?:[hH][tT][tT][pP][sS]?://\\S+|[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}(?::[0-9]{1,5})?(?:[/?#]\\S*)?|[0-9]{1,3}(?:\\.[0-9]{1,3}){3}(?::[0-9]{1,5})?(?:[/?#]\\S*)?|[lL][oO][cC][aA][lL][hH][oO][sS][tT](?::[0-9]{1,5})?(?:[/?#]\\S*)?)\\s*$",
          "minLength": 4,
          "maxLength": 2048
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "bareDomains",
      "type": "bool",
      "title": {
        "zh": "识别不带 http 的域名",
        "en": "Recognize domains without http"
      },
      "hint": {
        "zh": "如 deepseek.com。关闭后，只有 http(s):// 或 www. 开头的输入会被识别。",
        "en": "Such as deepseek.com. When off, only input starting with http(s):// or www. is recognized."
      },
      "default": true
    }
  ]
}
